# Copy this file to .env and fill in the values from your own Supabase
# project (Settings → API). Never commit the real .env file — it's already
# in .gitignore.
#
# Only the public anon key belongs here. The service-role key must never be
# used inside the mobile app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
