# Copy this file to .env and fill in the values from your own Supabase
# project (Settings → API). Never commit the real .env file — it's already
# in .gitignore.
#
# Only the public anon key belongs here. The service-role key must never be
# used inside the mobile app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# RevenueCat public API keys (safe to expose in the app bundle).
# Get these from your RevenueCat dashboard → Project Settings → API Keys.
# The secret key (for server-side validation) goes in Supabase secrets, NOT here:
#   supabase secrets set REVENUECAT_SECRET_KEY=sk_...
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_key_here
