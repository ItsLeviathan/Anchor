{
  "expo": {
    "name": "Anchor",
    "slug": "anchor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "anchor",
    "userInterfaceStyle": "automatic",
    "description": "Keep your life together. Tasks, calendar, bills, habits, documents, and notes — all in one calm place.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anchor.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Anchor uses the camera to scan and save documents.",
        "NSPhotoLibraryUsageDescription": "Anchor accesses your photo library to attach images to documents and notes.",
        "NSFaceIDUsageDescription": "Anchor uses Face ID to protect your private data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anchor.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Anchor Today",
              "description": "Your most important task, next event, and nearest deadline.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayWidget",
              "label": "Anchor Today",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Your most important task, next event, and nearest deadline.",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-local-authentication"
    ]
  }
}
